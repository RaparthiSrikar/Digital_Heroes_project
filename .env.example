# Environment variables required for production deployment on Vercel

# 1. DATABASE_URL
# WARNING: Vercel uses serverless functions, which means the local file system is read-only.
# A local SQLite database (`file:./dev.db`) will NOT persist data (new users, subscriptions, etc.)
# on Vercel. You must use a hosted database for production (e.g., Vercel Postgres, Supabase, Neon).
# Example for PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# 2. JWT_SECRET
# A long, random string used to sign JSON Web Tokens securely.
# You can generate one using `openssl rand -base64 32` in your terminal.
JWT_SECRET="your-super-secret-production-jwt-key"

# 3. Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://ezwrlvimfubqapyxrkdx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_hrTeFHfscKnyWGyxYO_gmg_Q8_qPIkB
